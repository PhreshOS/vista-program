{
    "compilerOptions": {
        "moduleResolution": "bundler",
        "noUnusedParameters": true,
        "noUnusedLocals": true,
        "skipLibCheck": true,
        "module": "ESNext",
        "target": "ESNext",
        "strict": true,
        "noEmit": true,
        "types": [
            "@types/node",
            "vite/client"
        ],
        "jsx": "react-jsx"
    },
    "include": [
        "client",
        "scripts",
        "tests",
        "phresh.config.ts",
        "vite.client.ts"
    ]
}
