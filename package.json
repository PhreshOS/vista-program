{
    "name": "vista-program",
    "displayName": "Vista",
    "private": true,
    "version": "0.1.0",
    "description": "Living scenes behind the windows, built by hand in 3D.",
    "type": "module",
    "packageManager": "bun@1.3.14",
    "author": "Zohayr SLILEH",
    "repository": {
        "type": "git",
