        "@types/node": "^26.4.0",
        "@types/three": "^0.186.0",
        "typescript": "^7.0.2",
        "vite": "^8.2.2",
        "vite-node": "^6.0.0",
        "vitest": "^4.1.10",
        "@babel/core": "^7.29.7",
